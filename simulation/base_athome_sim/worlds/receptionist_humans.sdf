<?xml version="1.0"?>
<!-- Receptionist camera experiment: 100 Hz physics (head 20 Hz, camera 15 Hz).
     Derived from casa_simple; selected explicitly, never changes the default world.
     Mundo simple para Base@Home: piso, paredes, puerta, mesa, sofá y dos sillas. -->
<sdf version="1.9">
  <world name="receptionist_humans">
    <physics name="1ms" type="ignored"><max_step_size>0.01</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <light type="directional" name="sol"><cast_shadows>false</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse><direction>-0.3 0.2 -1</direction></light>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.8 0.85 0.9 1</background></scene>

    <model name="piso"><static>true</static><link name="l">
      <collision name="c"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
      <visual name="v"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        <material><diffuse>0.55 0.5 0.45 1</diffuse><ambient>0.55 0.5 0.45 1</ambient></material></visual></link></model>

    <!-- Paredes: habitacion 8 x 6 m, puerta (hueco de 1 m) en la pared oeste -->
    <model name="paredes"><static>true</static><link name="l">
      <collision name="n"><pose>1 3 0.6 0 0 0</pose><geometry><box><size>8 0.1 1.2</size></box></geometry></collision>
      <visual name="n_visual"><pose>1 3 0.6 0 0 0</pose><geometry><box><size>8 0.1 1.2</size></box></geometry></visual>
      <collision name="s"><pose>1 -3 0.6 0 0 0</pose><geometry><box><size>8 0.1 1.2</size></box></geometry></collision>
      <visual name="s_visual"><pose>1 -3 0.6 0 0 0</pose><geometry><box><size>8 0.1 1.2</size></box></geometry></visual>
      <collision name="e"><pose>5 0 0.6 0 0 0</pose><geometry><box><size>0.1 6 1.2</size></box></geometry></collision>
      <visual name="e_visual"><pose>5 0 0.6 0 0 0</pose><geometry><box><size>0.1 6 1.2</size></box></geometry></visual>
      <collision name="w1"><pose>-3 1.75 0.6 0 0 0</pose><geometry><box><size>0.1 2.5 1.2</size></box></geometry></collision>
      <visual name="w1_visual"><pose>-3 1.75 0.6 0 0 0</pose><geometry><box><size>0.1 2.5 1.2</size></box></geometry></visual>
      <collision name="w2"><pose>-3 -1.75 0.6 0 0 0</pose><geometry><box><size>0.1 2.5 1.2</size></box></geometry></collision>
      <visual name="w2_visual"><pose>-3 -1.75 0.6 0 0 0</pose><geometry><box><size>0.1 2.5 1.2</size></box></geometry></visual>
    </link></model>

    <model name="coffee_table"><static>true</static><pose>2 0 0 0 0 0</pose><link name="l">
      <collision name="c"><pose>0 0 0.225 0 0 0</pose><geometry><box><size>0.8 0.8 0.45</size></box></geometry></collision>
      <visual name="v"><pose>0 0 0.225 0 0 0</pose><geometry><box><size>0.8 0.8 0.45</size></box></geometry></visual></link></model>
    <model name="recep_sofa"><static>true</static><pose>3.5 0 0 0 0 0</pose><link name="l">
      <collision name="seat"><pose>0 0 0.225 0 0 0</pose><geometry><box><size>0.6 1.2 0.45</size></box></geometry></collision>
      <visual name="seat_visual"><pose>0 0 0.225 0 0 0</pose><geometry><box><size>0.6 1.2 0.45</size></box></geometry></visual>
      <collision name="back"><pose>0.25 0 0.65 0 0 0</pose><geometry><box><size>0.1 1.2 0.4</size></box></geometry></collision>
      <visual name="back_visual"><pose>0.25 0 0.65 0 0 0</pose><geometry><box><size>0.1 1.2 0.4</size></box></geometry></visual></link></model>
    <model name="recepcionista_drop"><static>true</static><pose>4.35 0.55 0.015 0 0 0</pose><link name="l">
      <visual name="v"><geometry><box><size>0.65 0.65 0.03</size></box></geometry>
        <material><diffuse>0.15 0.65 0.25 1</diffuse></material></visual></link></model>

    <model name="silla_1"><static>true</static><pose>3.5 1.5 0 0 0 3.14</pose><link name="l">
      <collision name="c"><pose>0 0 0.225 0 0 0</pose><geometry><box><size>0.5 0.5 0.45</size></box></geometry></collision>
      <visual name="v"><pose>0 0 0.225 0 0 0</pose><geometry><box><size>0.5 0.5 0.45</size></box></geometry>
        <material><diffuse>0.2 0.3 0.6 1</diffuse></material></visual>
      <visual name="r"><pose>0.22 0 0.65 0 0 0</pose><geometry><box><size>0.06 0.5 0.4</size></box></geometry>
        <material><diffuse>0.2 0.3 0.6 1</diffuse></material></visual></link></model>
    <model name="silla_2"><static>true</static><pose>3.5 -1.5 0 0 0 3.14</pose><link name="l">
      <collision name="c"><pose>0 0 0.225 0 0 0</pose><geometry><box><size>0.5 0.5 0.45</size></box></geometry></collision>
      <visual name="v"><pose>0 0 0.225 0 0 0</pose><geometry><box><size>0.5 0.5 0.45</size></box></geometry>
        <material><diffuse>0.2 0.3 0.6 1</diffuse></material></visual>
      <visual name="r"><pose>0.22 0 0.65 0 0 0</pose><geometry><box><size>0.06 0.5 0.4</size></box></geometry>
        <material><diffuse>0.2 0.3 0.6 1</diffuse></material></visual></link></model>
  </world>
</sdf>
